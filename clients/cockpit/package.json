{
  "name": "@anulum/synapse-cockpit",
  "version": "0.1.0",
  "description": "Read-only real-time operator cockpit for the SYNAPSE CHANNEL coordination hub: fleet presence, claims and leases, task lifecycle, causality, and a live event spine.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "preview": "vite preview"
  },
  "keywords": [
    "synapse",
    "coordination",
    "multi-agent",
    "dashboard",
    "cockpit",
    "observability"
  ],
  "author": "Anulum Fortis & Arcane Sapience <protoscience@anulum.li>",
  "repository": {
    "type": "git",
    "url": "https://github.com/anulum/synapse-channel",
    "directory": "clients/cockpit"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
