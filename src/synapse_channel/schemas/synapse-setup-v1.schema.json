{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anulum.github.io/synapse-channel/schemas/synapse-setup-v1.schema.json",
  "title": "SYNAPSE CHANNEL machine-readable setup document v1",
  "oneOf": [
    { "$ref": "#/$defs/spec" },
    { "$ref": "#/$defs/inspection" },
    { "$ref": "#/$defs/plan" },
    { "$ref": "#/$defs/authorization" },
    { "$ref": "#/$defs/application_receipt" },
    { "$ref": "#/$defs/verification_plan" },
    { "$ref": "#/$defs/verification_authorization" },
    { "$ref": "#/$defs/verification_receipt" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "properties": {
        "schema_version": { "const": "synapse-setup.v1" },
        "profile": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "required": ["schema_version", "profile"]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "description": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "evidence_source": { "type": "string", "minLength": 1 },
        "remedy": { "type": "string" }
      },
      "required": ["id", "description", "required", "evidence_source", "remedy"]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "status": { "enum": ["pass", "warn", "fail", "unavailable"] },
        "required": { "type": "boolean" },
        "value": {},
        "detail": { "type": "string", "minLength": 1 },
        "remedy": { "type": "string" }
      },
      "required": ["id", "status", "required", "value", "detail", "remedy"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "project": { "type": "string", "minLength": 1, "maxLength": 128 },
        "identity": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "required": ["uri", "project", "identity"]
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "package_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "python_executable": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "synapse_executable": { "type": "string", "maxLength": 4096 },
        "platform_system": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "service_manager_executable": { "type": "string", "maxLength": 4096 }
      },
      "required": [
        "package_version", "python_executable", "synapse_executable", "platform_system",
        "service_manager_executable"
      ]
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "trigger_check": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "observed_status": { "enum": ["warn", "fail", "unavailable"] },
        "disposition": { "enum": ["planned", "blocked"] },
        "authority": {
          "enum": ["operator_confirmation", "operator_restart_authority", "unsupported"]
        },
        "disruption": {
          "enum": ["configuration_change", "environment_change", "service_start", "host_migration"]
        },
        "reversible": { "type": "boolean" },
        "verification_check": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "process_id": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 2, "maximum": 2147483647 }
          ]
        }
      },
      "required": [
        "id", "trigger_check", "observed_status", "disposition", "authority",
        "disruption", "reversible", "verification_check", "process_id"
      ]
    },
    "spec": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": { "const": "synapse-setup.v1" },
            "document_kind": { "const": "spec" },
            "profile": { "const": "local-single-user" },
            "profile_version": { "const": 1 },
            "summary": { "type": "string", "minLength": 1 },
            "scope": { "type": "string", "minLength": 1 },
            "read_only": { "const": true },
            "supported_operations": {
              "type": "array",
              "prefixItems": [
                { "const": "spec" },
                { "const": "inspect" },
                { "const": "plan" },
                { "const": "authorize" },
                { "const": "apply" },
                { "const": "verification-plan" },
                { "const": "authorize-verification" },
                { "const": "verify" }
              ],
              "items": false
            },
            "requirements": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/requirement" }
            }
          },
          "required": [
            "schema_version", "document_kind", "profile", "profile_version", "summary",
            "scope", "read_only", "supported_operations", "requirements"
          ]
        }
      ]
    },
    "inspection": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": { "const": "synapse-setup.v1" },
            "document_kind": { "const": "inspection" },
            "profile": { "const": "local-single-user" },
            "profile_version": { "const": 1 },
            "read_only": { "const": true },
            "ready": { "type": "boolean" },
            "target": { "$ref": "#/$defs/target" },
            "summary": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "pass": { "type": "integer", "minimum": 0 },
                "warn": { "type": "integer", "minimum": 0 },
                "fail": { "type": "integer", "minimum": 0 },
                "unavailable": { "type": "integer", "minimum": 0 }
              },
              "required": ["pass", "warn", "fail", "unavailable"]
            },
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/check" }
            }
          },
          "required": [
            "schema_version", "document_kind", "profile", "profile_version", "read_only",
            "ready", "target", "summary", "checks"
          ]
        }
      ]
    },
    "plan": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": { "const": "synapse-setup.v1" },
            "document_kind": { "const": "plan" },
            "profile": { "const": "local-single-user" },
            "profile_version": { "const": 1 },
            "read_only": { "const": true },
            "can_apply": { "type": "boolean" },
            "ready": { "type": "boolean" },
            "inspection_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "profile_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "plan_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "target": { "$ref": "#/$defs/target" },
            "generation": { "$ref": "#/$defs/generation" },
            "authority_required": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["operator_confirmation", "operator_restart_authority"]
              }
            },
            "effects": {
              "type": "array",
              "maxItems": 7,
              "items": { "$ref": "#/$defs/effect" }
            },
            "warnings": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["no_changes_required", "authorization_required", "manual_remediation_required"]
              }
            }
          },
          "required": [
            "schema_version", "document_kind", "profile", "profile_version", "read_only",
            "can_apply", "ready", "inspection_digest", "profile_digest", "plan_digest", "target",
            "generation",
            "authority_required", "effects", "warnings"
          ]
        }
      ]
    },
    "authorization": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": { "const": "synapse-setup.v1" },
            "document_kind": { "const": "authorization" },
            "profile": { "const": "local-single-user" },
            "profile_version": { "const": 1 },
            "read_only": { "const": true },
            "can_apply": { "const": true },
            "plan_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "authorization_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "target": { "$ref": "#/$defs/target" },
            "confirmation_nonce": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{22,128}$"
            },
            "issued_at": { "type": "integer", "minimum": 0 },
            "expires_at": { "type": "integer", "minimum": 30 },
            "authority_granted": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["operator_confirmation", "operator_restart_authority"]
              }
            },
            "restart_authority": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "pid": { "type": "integer", "minimum": 2, "maximum": 2147483647 }
                  },
                  "required": ["pid"]
                }
              ]
            },
            "consumption_required": { "const": true },
            "warnings": {
              "type": "array",
              "prefixItems": [{ "const": "single_use_authorization" }],
              "items": false
            }
          },
          "required": [
            "schema_version", "document_kind", "profile", "profile_version", "read_only",
            "can_apply", "plan_digest", "authorization_digest", "target",
            "confirmation_nonce", "issued_at", "expires_at", "authority_granted",
            "restart_authority", "consumption_required", "warnings"
          ]
        }
      ]
    },
    "application_effect_receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": ["establish_local_loopback_hub", "establish_identity_waiter"]
        },
        "unit": { "type": "string" },
        "outcome": { "enum": ["applied", "already_satisfied", "failed"] }
      },
      "required": ["id", "unit", "outcome"],
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "applied" } } },
          "then": { "properties": { "unit": { "minLength": 1 } } }
        },
        {
          "if": { "properties": { "outcome": { "const": "already_satisfied" } } },
          "then": { "properties": { "unit": { "const": "" } } }
        }
      ]
    },
    "protected_process": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pid": { "type": "integer", "minimum": 2, "maximum": 2147483647 },
        "before_alive": { "const": true },
        "after_alive": { "type": "boolean" }
      },
      "required": ["pid", "before_alive", "after_alive"]
    },
    "application_receipt": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": { "const": "synapse-setup.v1" },
            "document_kind": { "const": "application_receipt" },
            "profile": { "const": "local-single-user" },
            "profile_version": { "const": 1 },
            "plan_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "authorization_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "receipt_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "target": { "$ref": "#/$defs/target" },
            "started_at": { "type": "integer", "minimum": 0 },
            "completed_at": { "type": "integer", "minimum": 0 },
            "outcome": { "enum": ["applied", "recovered", "recovery_failed"] },
            "ledger_state": { "enum": ["applied", "recovered", "failed"] },
            "effects": {
              "type": "array",
              "maxItems": 2,
              "items": { "$ref": "#/$defs/application_effect_receipt" }
            },
            "protected_processes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/protected_process" }
            },
            "recovery": { "enum": ["not_required", "complete", "failed"] },
            "effect_receipt_digest": {
              "oneOf": [
                { "type": "null" },
                { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              ]
            }
          },
          "required": [
            "schema_version", "document_kind", "profile", "profile_version", "plan_digest",
            "authorization_digest", "receipt_digest", "target", "started_at", "completed_at",
            "outcome", "ledger_state", "effects", "protected_processes", "recovery",
            "effect_receipt_digest"
          ],
          "allOf": [
            {
              "if": { "properties": { "outcome": { "const": "applied" } } },
              "then": {
                "properties": {
                  "ledger_state": { "const": "applied" },
                  "recovery": { "const": "not_required" },
                  "effect_receipt_digest": { "type": "null" },
                  "effects": {
                    "items": {
                      "properties": {
                        "outcome": { "enum": ["applied", "already_satisfied"] }
                      }
                    }
                  },
                  "protected_processes": {
                    "items": { "properties": { "after_alive": { "const": true } } }
                  }
                }
              }
            },
            {
              "if": { "properties": { "outcome": { "const": "recovered" } } },
              "then": {
                "properties": {
                  "ledger_state": { "const": "recovered" },
                  "recovery": { "const": "complete" },
                  "effect_receipt_digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "protected_processes": {
                    "items": { "properties": { "after_alive": { "const": true } } }
                  }
                }
              }
            },
            {
              "if": { "properties": { "outcome": { "const": "recovery_failed" } } },
              "then": {
                "properties": {
                  "ledger_state": { "const": "failed" },
                  "recovery": { "const": "failed" },
                  "effect_receipt_digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "verification_plan": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": { "const": "synapse-setup.v1" },
            "document_kind": { "const": "verification_plan" },
            "profile": { "const": "local-single-user" },
            "profile_version": { "const": 1 },
            "read_only": { "const": true },
            "can_verify": { "const": true },
            "plan_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "authorization_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "application_receipt_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "inspection_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "verification_plan_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "target": { "$ref": "#/$defs/target" },
            "generation": { "$ref": "#/$defs/generation" },
            "current_hub_pid": { "type": "integer", "minimum": 2, "maximum": 2147483647 },
            "required_checks": {
              "type": "array",
              "prefixItems": [
                { "const": "directed_canary_delivery" },
                { "const": "exact_waiter_consumption" },
                { "const": "durable_restart_replay" },
                { "const": "strict_reinspection" },
                { "const": "protected_process_continuity" }
              ],
              "items": false
            },
            "warnings": {
              "type": "array",
              "prefixItems": [
                { "const": "restart_authorization_required" },
                { "const": "single_use_verification" }
              ],
              "items": false
            }
          },
          "required": [
            "schema_version", "document_kind", "profile", "profile_version", "read_only",
            "can_verify", "plan_digest", "authorization_digest", "application_receipt_digest",
            "inspection_digest", "verification_plan_digest", "target", "generation",
            "current_hub_pid", "required_checks", "warnings"
          ]
        }
      ]
    },
    "verification_authorization": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": { "const": "synapse-setup.v1" },
            "document_kind": { "const": "verification_authorization" },
            "profile": { "const": "local-single-user" },
            "profile_version": { "const": 1 },
            "read_only": { "const": true },
            "can_verify": { "const": true },
            "verification_plan_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "verification_authorization_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "target": { "$ref": "#/$defs/target" },
            "confirmation_nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22,128}$" },
            "issued_at": { "type": "integer", "minimum": 0 },
            "expires_at": { "type": "integer", "minimum": 30 },
            "restart_authority": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "pid": { "type": "integer", "minimum": 2, "maximum": 2147483647 }
              },
              "required": ["pid"]
            },
            "consumption_required": { "const": true },
            "warnings": {
              "type": "array",
              "prefixItems": [{ "const": "single_use_verification_authorization" }],
              "items": false
            }
          },
          "required": [
            "schema_version", "document_kind", "profile", "profile_version", "read_only",
            "can_verify", "verification_plan_digest", "verification_authorization_digest",
            "target", "confirmation_nonce", "issued_at", "expires_at", "restart_authority",
            "consumption_required", "warnings"
          ]
        }
      ]
    },
    "verification_check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "directed_canary_delivery", "exact_waiter_consumption", "durable_restart_replay",
            "strict_reinspection", "protected_process_continuity"
          ]
        },
        "status": { "enum": ["pass", "fail", "not_run"] }
      },
      "required": ["id", "status"]
    },
    "verification_receipt": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": { "const": "synapse-setup.v1" },
            "document_kind": { "const": "verification_receipt" },
            "profile": { "const": "local-single-user" },
            "profile_version": { "const": 1 },
            "verification_plan_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "verification_authorization_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "plan_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "authorization_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "application_receipt_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "receipt_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "target": { "$ref": "#/$defs/target" },
            "generation": { "$ref": "#/$defs/generation" },
            "started_at": { "type": "integer", "minimum": 0 },
            "completed_at": { "type": "integer", "minimum": 0 },
            "outcome": { "enum": ["verified", "failed"] },
            "ledger_state": { "enum": ["verified", "failed"] },
            "canary_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
            "message_seq": {
              "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }]
            },
            "chat_digest": {
              "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }]
            },
            "ack_event_seq": {
              "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }]
            },
            "ack_digest": {
              "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }]
            },
            "hub_pid_before": { "type": "integer", "minimum": 2, "maximum": 2147483647 },
            "hub_pid_after": {
              "oneOf": [
                { "type": "null" },
                { "type": "integer", "minimum": 2, "maximum": 2147483647 }
              ]
            },
            "protected_processes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/protected_process" }
            },
            "checks": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "prefixItems": [
                {
                  "allOf": [
                    { "$ref": "#/$defs/verification_check" },
                    { "properties": { "id": { "const": "directed_canary_delivery" } } }
                  ]
                },
                {
                  "allOf": [
                    { "$ref": "#/$defs/verification_check" },
                    { "properties": { "id": { "const": "exact_waiter_consumption" } } }
                  ]
                },
                {
                  "allOf": [
                    { "$ref": "#/$defs/verification_check" },
                    { "properties": { "id": { "const": "durable_restart_replay" } } }
                  ]
                },
                {
                  "allOf": [
                    { "$ref": "#/$defs/verification_check" },
                    { "properties": { "id": { "const": "strict_reinspection" } } }
                  ]
                },
                {
                  "allOf": [
                    { "$ref": "#/$defs/verification_check" },
                    { "properties": { "id": { "const": "protected_process_continuity" } } }
                  ]
                }
              ],
              "items": false
            },
            "failure_code": {
              "oneOf": [
                { "type": "null" },
                {
                  "enum": [
                    "verification_target_changed", "verification_protected_process_missing",
                    "verification_canary_failed", "verification_restart_failed",
                    "verification_replay_failed"
                  ]
                }
              ]
            }
          },
          "required": [
            "schema_version", "document_kind", "profile", "profile_version",
            "verification_plan_digest", "verification_authorization_digest", "plan_digest",
            "authorization_digest", "application_receipt_digest", "receipt_digest", "target",
            "generation", "started_at", "completed_at", "outcome", "ledger_state", "canary_id",
            "message_seq", "chat_digest", "ack_event_seq", "ack_digest", "hub_pid_before",
            "hub_pid_after", "protected_processes", "checks", "failure_code"
          ],
          "allOf": [
            {
              "if": { "properties": { "outcome": { "const": "verified" } } },
              "then": {
                "properties": {
                  "ledger_state": { "const": "verified" },
                  "message_seq": { "type": "integer", "minimum": 1 },
                  "chat_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "ack_event_seq": { "type": "integer", "minimum": 1 },
                  "ack_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "hub_pid_after": { "type": "integer", "minimum": 2, "maximum": 2147483647 },
                  "failure_code": { "type": "null" },
                  "checks": { "items": { "properties": { "status": { "const": "pass" } } } },
                  "protected_processes": {
                    "items": { "properties": { "after_alive": { "const": true } } }
                  }
                }
              }
            },
            {
              "if": { "properties": { "outcome": { "const": "failed" } } },
              "then": {
                "properties": {
                  "ledger_state": { "const": "failed" },
                  "failure_code": { "type": "string" },
                  "checks": {
                    "contains": {
                      "type": "object",
                      "properties": { "status": { "const": "fail" } },
                      "required": ["status"]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "error": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": { "const": "synapse-setup.v1" },
            "document_kind": { "const": "error" },
            "command": {
              "enum": [
                "spec", "inspect", "plan", "authorize", "apply", "verification-plan",
                "authorize-verification", "verify"
              ]
            },
            "profile": { "type": "string", "minLength": 1, "maxLength": 128 },
            "code": {
              "enum": [
                "unknown_profile", "invalid_uri", "inspection_failed", "planning_failed",
                "invalid_plan", "digest_mismatch", "invalid_nonce", "invalid_expiry",
                "plan_blocked", "restart_authority_required", "unexpected_restart_authority",
                "authorization_failed", "invalid_authorization", "authorization_expired",
                "authorization_mismatch", "authorization_replayed",
                "authorization_ledger_unavailable", "authorization_transition_invalid",
                "application_target_changed", "application_platform_unsupported",
                "application_lock_unavailable", "application_protected_process_missing",
                "application_effect_failed", "application_recovery_failed",
                "application_receipt_unavailable", "invalid_application_receipt",
                "verification_planning_failed", "invalid_verification_plan",
                "verification_authorization_failed", "invalid_verification_authorization",
                "verification_authorization_replayed", "verification_ledger_unavailable",
                "verification_target_changed", "verification_lock_unavailable",
                "verification_protected_process_missing", "verification_canary_failed",
                "verification_restart_failed", "verification_replay_failed",
                "verification_receipt_unavailable"
              ]
            },
            "message": { "type": "string", "minLength": 1 }
          },
          "required": ["schema_version", "document_kind", "command", "profile", "code", "message"]
        }
      ]
    }
  }
}
