{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anulum.github.io/synapse-channel/schemas/synapse-setup-v1.schema.json",
  "title": "SYNAPSE CHANNEL machine-readable setup document v1",
  "oneOf": [
    { "$ref": "#/$defs/spec" },
    { "$ref": "#/$defs/inspection" },
    { "$ref": "#/$defs/plan" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "properties": {
        "schema_version": { "const": "synapse-setup.v1" },
        "profile": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "required": ["schema_version", "profile"]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "description": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "evidence_source": { "type": "string", "minLength": 1 },
        "remedy": { "type": "string" }
      },
      "required": ["id", "description", "required", "evidence_source", "remedy"]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "status": { "enum": ["pass", "warn", "fail", "unavailable"] },
        "required": { "type": "boolean" },
        "value": {},
        "detail": { "type": "string", "minLength": 1 },
        "remedy": { "type": "string" }
      },
      "required": ["id", "status", "required", "value", "detail", "remedy"]
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "trigger_check": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "observed_status": { "enum": ["warn", "fail", "unavailable"] },
        "disposition": { "enum": ["planned", "blocked"] },
        "authority": {
          "enum": ["operator_confirmation", "operator_restart_authority", "unsupported"]
        },
        "disruption": {
          "enum": ["configuration_change", "environment_change", "service_start", "host_migration"]
        },
        "reversible": { "type": "boolean" },
        "verification_check": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
      },
      "required": [
        "id", "trigger_check", "observed_status", "disposition", "authority",
        "disruption", "reversible", "verification_check"
      ]
    },
    "spec": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": { "const": "synapse-setup.v1" },
            "document_kind": { "const": "spec" },
            "profile": { "const": "local-single-user" },
            "profile_version": { "const": 1 },
            "summary": { "type": "string", "minLength": 1 },
            "scope": { "type": "string", "minLength": 1 },
            "read_only": { "const": true },
            "supported_operations": {
              "type": "array",
              "prefixItems": [
                { "const": "spec" },
                { "const": "inspect" },
                { "const": "plan" }
              ],
              "items": false
            },
            "requirements": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/requirement" }
            }
          },
          "required": [
            "schema_version", "document_kind", "profile", "profile_version", "summary",
            "scope", "read_only", "supported_operations", "requirements"
          ]
        }
      ]
    },
    "inspection": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": { "const": "synapse-setup.v1" },
            "document_kind": { "const": "inspection" },
            "profile": { "const": "local-single-user" },
            "profile_version": { "const": 1 },
            "read_only": { "const": true },
            "ready": { "type": "boolean" },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "uri": { "type": "string", "minLength": 1 },
                "project": { "type": "string", "minLength": 1 },
                "identity": { "type": "string", "minLength": 1 }
              },
              "required": ["uri", "project", "identity"]
            },
            "summary": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "pass": { "type": "integer", "minimum": 0 },
                "warn": { "type": "integer", "minimum": 0 },
                "fail": { "type": "integer", "minimum": 0 },
                "unavailable": { "type": "integer", "minimum": 0 }
              },
              "required": ["pass", "warn", "fail", "unavailable"]
            },
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/check" }
            }
          },
          "required": [
            "schema_version", "document_kind", "profile", "profile_version", "read_only",
            "ready", "target", "summary", "checks"
          ]
        }
      ]
    },
    "plan": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": { "const": "synapse-setup.v1" },
            "document_kind": { "const": "plan" },
            "profile": { "const": "local-single-user" },
            "profile_version": { "const": 1 },
            "read_only": { "const": true },
            "can_apply": { "const": false },
            "ready": { "type": "boolean" },
            "inspection_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "profile_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "plan_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "authority_required": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["operator_confirmation", "operator_restart_authority"]
              }
            },
            "effects": {
              "type": "array",
              "maxItems": 7,
              "items": { "$ref": "#/$defs/effect" }
            },
            "warnings": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["apply_not_available", "manual_remediation_required"] }
            }
          },
          "required": [
            "schema_version", "document_kind", "profile", "profile_version", "read_only",
            "can_apply", "ready", "inspection_digest", "profile_digest", "plan_digest",
            "authority_required", "effects", "warnings"
          ]
        }
      ]
    },
    "error": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": { "const": "synapse-setup.v1" },
            "document_kind": { "const": "error" },
            "command": { "enum": ["spec", "inspect", "plan"] },
            "profile": { "type": "string", "minLength": 1, "maxLength": 128 },
            "code": {
              "enum": ["unknown_profile", "invalid_uri", "inspection_failed", "planning_failed"]
            },
            "message": { "type": "string", "minLength": 1 }
          },
          "required": ["schema_version", "document_kind", "command", "profile", "code", "message"]
        }
      ]
    }
  }
}
