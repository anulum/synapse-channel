{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anulum.github.io/synapse-channel/schemas/synapse-setup-v1.schema.json",
  "title": "SYNAPSE CHANNEL machine-readable setup document v1",
  "oneOf": [
    { "$ref": "#/$defs/spec" },
    { "$ref": "#/$defs/inspection" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "properties": {
        "schema_version": { "const": "synapse-setup.v1" },
        "profile": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "required": ["schema_version", "profile"]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "description": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "evidence_source": { "type": "string", "minLength": 1 },
        "remedy": { "type": "string" }
      },
      "required": ["id", "description", "required", "evidence_source", "remedy"]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "status": { "enum": ["pass", "warn", "fail", "unavailable"] },
        "required": { "type": "boolean" },
        "value": {},
        "detail": { "type": "string", "minLength": 1 },
        "remedy": { "type": "string" }
      },
      "required": ["id", "status", "required", "value", "detail", "remedy"]
    },
    "spec": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": { "const": "synapse-setup.v1" },
            "document_kind": { "const": "spec" },
            "profile": { "const": "local-single-user" },
            "profile_version": { "const": 1 },
            "summary": { "type": "string", "minLength": 1 },
            "scope": { "type": "string", "minLength": 1 },
            "read_only": { "const": true },
            "supported_operations": {
              "type": "array",
              "prefixItems": [{ "const": "spec" }, { "const": "inspect" }],
              "items": false
            },
            "requirements": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/requirement" }
            }
          },
          "required": [
            "schema_version", "document_kind", "profile", "profile_version", "summary",
            "scope", "read_only", "supported_operations", "requirements"
          ]
        }
      ]
    },
    "inspection": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": { "const": "synapse-setup.v1" },
            "document_kind": { "const": "inspection" },
            "profile": { "const": "local-single-user" },
            "profile_version": { "const": 1 },
            "read_only": { "const": true },
            "ready": { "type": "boolean" },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "uri": { "type": "string", "minLength": 1 },
                "project": { "type": "string", "minLength": 1 },
                "identity": { "type": "string", "minLength": 1 }
              },
              "required": ["uri", "project", "identity"]
            },
            "summary": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "pass": { "type": "integer", "minimum": 0 },
                "warn": { "type": "integer", "minimum": 0 },
                "fail": { "type": "integer", "minimum": 0 },
                "unavailable": { "type": "integer", "minimum": 0 }
              },
              "required": ["pass", "warn", "fail", "unavailable"]
            },
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/check" }
            }
          },
          "required": [
            "schema_version", "document_kind", "profile", "profile_version", "read_only",
            "ready", "target", "summary", "checks"
          ]
        }
      ]
    },
    "error": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": { "const": "synapse-setup.v1" },
            "document_kind": { "const": "error" },
            "command": { "enum": ["spec", "inspect"] },
            "profile": { "type": "string", "minLength": 1, "maxLength": 128 },
            "code": { "enum": ["unknown_profile", "invalid_uri", "inspection_failed"] },
            "message": { "type": "string", "minLength": 1 }
          },
          "required": ["schema_version", "document_kind", "command", "profile", "code", "message"]
        }
      ]
    }
  }
}
